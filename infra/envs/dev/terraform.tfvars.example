# Copy to terraform.tfvars (git-ignored) and fill in. The repo is public: these stay local.
slack_approval_channel = "C0123456789"         # the channel id from Slack's channel details
github_oauth_client_id = "Iv1.0000000000000000" # the GitHub App's Client ID
worker_image_tag       = "abc1234"              # the commit `make worker-image` built and you pushed
alert_email            = "you@example.com"      # alarm emails (model spend); confirm SNS's email once

# Load-test mode (M7): set true for a test, false right after (load_test.tf).
# load_test = true
# Load values for one test (all five; replaces the defaults in variables.tf), removed after:
# load_test_settings = {
#   api_throttle_rate  = 1000
#   api_throttle_burst = 2000
#   worker_max_tasks   = 20
#   worker_concurrency = 50
#   stub_latency_ms    = 15000 # chaos: runs outlast the 30 s ECS stop timeout
# }


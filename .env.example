# Copy to .env (make up does this if .env is missing). Values are for services running on your
# machine against the local stack. Never put real AWS credentials here.

# Fake credentials: DynamoDB Local and ElasticMQ accept anything.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

# Local endpoints, read by both AWS SDKs (unset in AWS).
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000
AWS_ENDPOINT_URL_SQS=http://localhost:9324

# Control plane
STORE_BACKEND=dynamodb
CONTROL_PLANE_TABLE=control-plane
TENANT_ID=tenant-demo
TENANT_API_KEY=local-dev-key
# GitHub webhooks (POST /triggers/github). Unset: the route answers 503. Use a long random value,
# e.g. `openssl rand -hex 32`, and paste the same value into the repo's webhook settings.
# GITHUB_WEBHOOK_SECRET=
# Re-enqueue sweep for runs left QUEUED (defaults shown; interval 0 turns it off).
# SWEEP_INTERVAL_SECONDS=60
# SWEEP_QUEUED_AFTER_SECONDS=300

# Run queue (control plane sends, worker receives)
QUEUE_BACKEND=sqs
RUN_QUEUE_URL=http://localhost:9324/000000000000/runs

# Worker (defaults shown; the worker also reads RUN_QUEUE_URL and AWS_* above)
CONTROL_PLANE_URL=http://localhost:8080
TOOLS_PROVIDER=fake
WORKER_CONCURRENCY=4

# Run state: lease, checkpoints, tool-call claims (worker; ADR 0011)
STATE_BACKEND=dynamodb
STATE_TABLE=run-state

# Model providers (ADR 0010). Specs name the model as <provider>/<model id>; `stub` is built in.
# To use MiniMax, uncomment and put the real key in .env only (git-ignored), never here.
# MODEL_PROVIDERS=minimax
# MODEL_MINIMAX_PROTOCOL=openai
# MODEL_MINIMAX_BASE_URL=https://api.minimax.io/v1
# MODEL_MINIMAX_API_KEY=
# MODEL_MINIMAX_EXTRA_BODY='{"reasoning_split":true}'
# Amazon Bedrock (optional): no keys here. Credentials come from a named profile in ~/.aws, which
# also keeps the fake AWS keys above out of Bedrock calls. Add bedrock to MODEL_PROVIDERS
# (e.g. minimax,bedrock) and use model: bedrock/amazon.nova-lite-v1:0 in a spec.
# MODEL_BEDROCK_PROTOCOL=bedrock
# MODEL_BEDROCK_AWS_PROFILE=default
# MODEL_BEDROCK_REGION=us-east-1
# MODEL_BEDROCK_TEMPERATURE=0
# MODEL_BEDROCK_EXTRA_BODY='{"inferenceConfig":{"topK":1}}'

# Real GitHub tools (M1, ADR 0006 stage 1). Set TOOLS_PROVIDER=local above, then uncomment.
# Fine-grained token limited to the sandbox repo, Issues: read and write. Real token in .env only.
# GITHUB_TOKEN=
# GITHUB_REPOS=owner/repo

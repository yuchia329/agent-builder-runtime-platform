{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Eval task",
  "description": "One case for an agent: which spec runs, the trigger event, the starting state of the simulated services, and the checks that decide pass or fail. Tasks live in evals/tasks/<spec>/*.yaml.",
  "type": "object",
  "required": ["spec", "about", "input", "world", "checks"],
  "additionalProperties": false,
  "properties": {
    "spec": {
      "description": "Spec name: specs/<spec>.yaml is run (the working copy).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "about": { "description": "What the case is about, one line.", "type": "string", "minLength": 1 },
    "input": { "description": "The run input: the trigger event as the control plane would store it.", "type": "object" },
    "world": {
      "description": "Starting state per simulated connector.",
      "type": "object",
      "additionalProperties": false,
      "properties": { "github": { "$ref": "#/$defs/githubWorld" } }
    },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "labelName": { "type": "string", "minLength": 1, "maxLength": 50 },
    "githubWorld": {
      "description": "The one repository the gateway allows (octocat/Hello-World).",
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "issues"],
      "properties": {
        "labels": { "type": "array", "items": { "$ref": "#/$defs/labelName" }, "uniqueItems": true },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/githubIssue" } }
      }
    },
    "githubIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "state": { "enum": ["open", "closed"] },
        "state_reason": { "enum": ["completed", "not_planned", "duplicate"] },
        "labels": { "type": "array", "items": { "$ref": "#/$defs/labelName" }, "uniqueItems": true },
        "pull_request": { "description": "A pull request (GitHub serves them as issues too).", "type": "boolean" }
      }
    },
    "toolMatch": {
      "description": "Calls of `tool` whose arguments hold every listed key with exactly that value; other keys are ignored.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool"],
      "properties": {
        "tool": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" }
      }
    },
    "check": {
      "description": "Exactly one kind per entry.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "status": {
          "description": "The run's final status.",
          "enum": ["SUCCEEDED", "FAILED"]
        },
        "failure_reason": {
          "description": "The final failure reason (status FAILED).",
          "type": "string"
        },
        "tool_called": {
          "description": "At least one matching call ran without a tool error.",
          "$ref": "#/$defs/toolMatch"
        },
        "tool_not_called": {
          "description": "No matching call was even attempted.",
          "$ref": "#/$defs/toolMatch"
        },
        "github": {
          "description": "One issue's end state; only the listed fields are compared. labels: exactly this set.",
          "type": "object",
          "additionalProperties": false,
          "required": ["issue"],
          "properties": {
            "issue": { "type": "integer", "minimum": 1 },
            "labels": { "type": "array", "items": { "$ref": "#/$defs/labelName" }, "uniqueItems": true },
            "labels_include": { "type": "array", "items": { "$ref": "#/$defs/labelName" }, "minItems": 1 },
            "labels_exclude": { "type": "array", "items": { "$ref": "#/$defs/labelName" }, "minItems": 1 },
            "state": { "enum": ["open", "closed"] },
            "state_reason": { "enum": ["completed", "not_planned", "duplicate", null] },
            "duplicate_of": { "type": ["integer", "null"], "minimum": 1 }
          }
        },
        "output": {
          "description": "Regular expressions (Python syntax) the final answer must match or must not match.",
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "matches": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "not_matches": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
